{
  "name": "theuselessvibe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discover small GitHub Pages games, with evidence-backed phrase and agent filters.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "collect": "python3 scripts/collect.py --state .cache/catalog.sqlite --output site/data --config config/search.json",
    "serve": "python3 -m http.server 8000 --directory site"
  },
  "engines": {"node": ">=22"},
  "license": "MIT"
}
